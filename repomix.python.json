{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "REPOMIX_PYTHON_ESTADO_ACTUAL.md",
    "style": "markdown",
    "filePathStyle": "target-relative",
    "parsableStyle": true,
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "compress": false,
    "topFilesLength": 15,
    "showLineNumbers": true,
    "truncateBase64": true,
    "copyToClipboard": false,
    "headerText": "REPOMIX — ESTADO ACTUAL DE IN CRYPTA (PYTHON / PYGAME-CE)\nFoco exclusivo: Lógica de juego, físicas Celeste, entidades, combate, niveles, HUD, sintetizador procedural y diseño lúdico.\nSe excluyen por completo herramientas de exportación, GDevelop, scripts web y duplicados."
  },
  "include": [
    "main.py",
    "juego.py",
    "config.py",
    "entidades.py",
    "nivel.py",
    "niveles.py",
    "niveles_rediseñados.py",
    "hud.py",
    "audio.py",
    "camara.py",
    "efectos.py",
    "particulas.py",
    "assets_loader.py",
    "jugar_pygame.sh",
    "requirements.txt",
    "README.md",
    "tests/test_logica.py",
    "tests/test_hud.py",
    "tests/test_audio_carga.py",
    "tests/test_importar_assets.py",
    "docs/PROMPT_MAESTRO_GAME_DESIGN.xml",
    "docs/PROMPT_MAESTRO_GAME_DESIGN.md",
    "docs/INVESTIGACION_AUDIOVISUAL_UX.md",
    "docs/PROMPT_CURVA_DIFICULTAD_MDA.md",
    "docs/PROMPT_MEJORA_AUDIOVISUAL_UX_PROCEDURAL.md",
    "docs/DISENO_VISUAL_PYGAME.md",
    "docs/GDD_MDA.md",
    "docs/ROOM_TESTS.md"
  ],
  "ignore": {
    "useGitignore": false,
    "useDotIgnore": false,
    "useDefaultPatterns": true,
    "customPatterns": [
      "export/**",
      "tools/**",
      "In-Crypta/**",
      "IN_CRYPTA_**",
      "repomix/**",
      "capturas/**",
      "**/*.pyc",
      "**/__pycache__/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.ogg",
      "**/*.wav",
      "**/*.ttf",
      "**/*.zip",
      "pipeline_in_crypta.py",
      "tests/test_export_*",
      "tests/test_fisica_gdjs.js"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
